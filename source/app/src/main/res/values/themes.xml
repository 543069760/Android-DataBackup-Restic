<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.DataBackup" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
    </style>

    <style name="Theme.DataBackup.SplashScreen" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ic_launcher_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.DataBackup</item>
    </style>

    <!-- 与所选桌面图标配套：活动别名无法指定 theme，因此在 SplashActivity 启动时按偏好 setTheme。 -->
    <style name="Theme.DataBackup.SplashScreen.DeviceBridge" parent="Theme.DataBackup.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ic_launcher_bridge_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_bridge_foreground</item>
    </style>

    <style name="Theme.DataBackup.SplashScreen.ShieldSync" parent="Theme.DataBackup.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ic_launcher_shield_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_shield_foreground</item>
    </style>
</resources>