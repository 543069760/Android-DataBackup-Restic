<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="benchmark_intro_title">测试说明</string>
    <string name="benchmark_intro_desc">在应用私有目录生成 128 MiB 固定测试数据，为 5 个档位（OFF / L1 / L3 / L6 / L19）分别建临时仓库并写入快照，走的是与真实备份完全相同的 tar 与 rustic 路径。需要约 320 MiB 可用空间；结束后临时仓库与测试数据会一并删除，不会触碰你的真实仓库。</string>
